<?xml version="1.0" encoding="utf-8"?>
<!-- Security §3: enrollment secrets must never leave this device via backup.
     allowBackup=false + fullBackupContent=false already disable backup on
     API <= 30; on API 31+ the OS reads dataExtractionRules instead, so both
     the cloud-backup and the device-transfer (D2D) sections must exclude the
     flutter_secure_storage prefs files. FSS v11 `storageNamespace` scopes
     each instance: data prefs = "<namespace>.xml", wrapped-key prefs =
     "FlutterSecureKeyStorage:<namespace>.xml", KeyStore aliases gain
     ".<namespace>". Enrollment (prox_enroll, biometric AES-wrap) + seal DEK
     (prox_seal, RSA wrap) live in separate namespaces so their algorithm
     markers can never collide; Keystore keys are never backed up by the OS
     regardless. Legacy default-namespace files stay excluded for one
     release so upgrading installs cannot leak orphaned prefs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="prox_enroll.xml" />
        <exclude domain="sharedpref" path="prox_seal.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:prox_enroll.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:prox_seal.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="sharedpref" path="prox_enroll.xml" />
        <exclude domain="sharedpref" path="prox_seal.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:prox_enroll.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage:prox_seal.xml" />
    </device-transfer>
</data-extraction-rules>
