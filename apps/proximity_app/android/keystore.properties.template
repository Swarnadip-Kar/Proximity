# Release signing credentials — TEMPLATE ONLY. Never put real secrets here.
# Copy to `keystore.properties` (same directory, gitignored, never committed)
# and fill in the real values:
#   cp keystore.properties.template keystore.properties
#
# Mint the release key ONCE on the release manager's machine. This file must
# never travel with the repo — back up the keystore offline (encrypted USB /
# password manager). Losing it permanently bricks Play Store updates for this
# app id; leaking it lets anyone ship "Proximity" updates.
#
#   keytool -genkeypair -v -keystore ~/proximity-release.keystore \
#     -alias proximity-release -keyalg RSA -keysize 4096 -validity 10000
#
# Print the SHA-256 fingerprint for certSha256 below (and for Play Console >
# Release > Setup > App integrity > App signing):
#
#   keytool -list -v -keystore ~/proximity-release.keystore \
#     -alias proximity-release | grep SHA256
#
# CI alternative for certSha256 (signing passwords still come from THIS file,
# which CI must provision as a secret file, never from the repo):
#   ./gradlew bundleRelease -PreleaseCertSha256=<64-hex-chars>
# or env:  RELEASE_CERT_SHA256=<64-hex-chars>

# Absolute path preferred (outside the repo). Relative paths resolve against
# the android/ directory, e.g. ../proximity-release.keystore
storeFile=/Users/<you>/proximity-release.keystore
storePassword=CHANGE_ME_store_password
keyAlias=proximity-release
keyPassword=CHANGE_ME_key_password
# 64 hex chars, colons optional (normalized at build time). Get it from the
# `keytool -list` command above.
certSha256=CHANGE_ME_64_hex_sha256_of_release_cert
