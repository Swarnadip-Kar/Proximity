rules_version = '2';
// Proximity — Campus Attendance System (project: proximity-attendence).
//
// Identity is the Google account itself. Track 1 org = the lowercased
// Google-account domain (gmail.com is a normal org; subdomains exact-match).
// Every doc below stamps `org`; cross-org reads/writes are denied. Legacy
// docs without org ('') keep a temporary owner-only grace (classSessions
// reads + stamp-on-update) so the upgrade does not strand data — remove
// the grace ONLY after SyncEngine's backfill-complete signal has fired
// (one-time persisted flag + SYNC log) AND the org-wide console check
// (all four collections, where org missing) returns zero. The signal is
// the gate. The engine's unfiltered legacy-discovery pull exists so
// untouched cloud legacy cannot strand this grace open forever.
//
//   users/{uid}: {email, name, roles[prof|student], displayName, lastMode,
//     org, updatedAt} — one doc per Firebase uid; the SAME Gmail can hold BOTH
//     roles (professor on many devices, student on exactly one). lastMode
//     is the last-used mode (landing + relaunch default). Gets (not lists)
//     so a missing doc reads as not-found, never denied.
//   studentDevices/{lowercased-email}: {email, uid, pkHex, installId, name,
//     roll, modelVer, platform, org, createdAt/lastMoveAt/lastSeenAt/
//     updatedAtMillis, moveCount, pkDHex, attestationLevel,
//     attestedAt/attestedUntilMillis} — one enrolled student device per
//     Gmail. There is no server side to this binding: attestation level +
//     window are self-asserted by the enrolling client and checked for
//     consistency (not cryptographic proof) by offline verifiers — see
//     the trust-model note in PROXIMITY_DESIGN.md.
//     Same-install re-keys are always allowed; a move to a different
//     install needs the 30-day cooldown (a bare pkHex match from another
//     install is a move, not the same device)
//     (request.time - lastMoveAtMillis > 30d) unless the doc predates
//     timestamps (one migration move) or the STORED lastSeen proves the
//     old phone lost (request.time - lastSeenAtMillis > 60d — server clock
//     only; a move-time "I've been offline" is worthless, and the stored
//     value is trustworthy because every write stamping it must land within
//     1h of request.time or the write is refused). Clients claim via a
//     transaction so racing devices resolve to exactly one winner. Face photos/templates
//     are NEVER written here — only the device public key + install id +
//     attestation material. NO face-derived data reaches ANY collection:
//     duplicate detection runs in memory on the professor's phone during
//     the live local session (vectors ride the LAN prove body, RAM-only).
//   deviceInstalls/{installId}: {email, pkHex, org, updatedAtMillis} — one
//     student Gmail per app install. The installId lives in secure storage,
//     so app clones / dual-app copies / work profiles get their own: the
//     same phone can never hold two student enrollments. Deletes are never
//     needed (a wipe generates a fresh installId).
//   studentDirectory/{emailLower}: {email, name, roll, nameLower, org,
//     updatedAtMillis} — minimal professor-searchable directory, maintained
//     by the claim transaction. Professors (role-gated) prefix-search it to
//     add students to records; students read only their own doc. NOTE: the
//     prof gate is advisory until professor roles are institute-verified —
//     any self-registered prof can list it (emails/names/rolls only), but
//     ONLY within their own org (list is per-doc org-gated; cross-org rows
//     deny as a whole, so clients always filter where('org', == myOrg)).
//   classSessions/{sessionId}: {courseId, courseName, classLabel, profUid,
//     profEmail, profName, org, dateIso, timestampIso, startIso, windows, names,
//     rolls, studentEmails[], updatedAt} — professors own their sessions; a student
//     reads only same-org sessions listing their Gmail (array-contains). Queries
//     filter where('org', == myOrg) plus the single owner/membership filter
//     and sort client-side (composite indexes in firestore.indexes.json).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function ownUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function tokenEmail() {
      return request.auth.token.email;
    }
    // Gmail is case-insensitive but the token preserves case: every doc id
    // and email comparison below lowercases both sides (was raw compare —
    // a mixed-case Gmail denied its own docs / missed its sessions).
    function tokenEmailLower() {
      return tokenEmail().lower();
    }
    // Track 1 org: the caller's Google-account domain. gmail.com is a
    // normal org; subdomains exact-match server-side exactly as orgOf does
    // client-side (no stripping, no blocklist).
    function tokenOrg() {
      let parts = tokenEmailLower().split('@');
      let domain = parts.size() > 1 ? parts[1] : '';
      return domain == 'googlemail.com' ? 'gmail.com' : domain;
    }
    function validRoles(rs) {
      return rs is list && rs.size() >= 1 && rs.size() <= 2 &&
        rs.hasOnly(['prof', 'student']);
    }
    function validLastMode(m) {
      return m == '' || m == 'prof' || m == 'student';
    }
    function callerIsProf() {
      return signedIn() &&
        exists(/databases/$(db)/documents/users/$(request.auth.uid)) &&
        'prof' in get(/databases/$(db)/documents/users/$(request.auth.uid))
          .data.get('roles', []);
    }
    // Legacy grace: docs stamped before Track 1 carry no org (missing key
    // or ''). They stay owner-visible until the backfill stamps them.
    function missingOrg(data) {
      return !('org' in data) || data.org == '';
    }
    // Six-month purge gate (owner-lazy, no backend): the STORED stamp is
    // past 180d by the SERVER clock (request.time — client clocks decide
    // nothing). Callers must hasAll-guard the key first: reading a missing
    // key errors instead of yielding false. Zero/undated stamps deny
    // (fail-closed — a live enrollment can never be taken by this gate).
    function purgeStale(stamp) {
      return stamp is int && stamp > 0 &&
        request.time.toMillis() - stamp > 180 * 24 * 60 * 60 * 1000;
    }

    match /users/{uid} {
      allow get: if ownUid(uid);
      allow list: if false;
      allow create: if ownUid(uid)
        && request.resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.org == tokenOrg()
        && validRoles(request.resource.data.roles)
        && (!('lastMode' in request.resource.data) ||
            validLastMode(request.resource.data.lastMode));
      allow update: if ownUid(uid)
        && resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.org == tokenOrg()
        && (missingOrg(resource.data) ||
            resource.data.org == tokenOrg())
         && validRoles(request.resource.data.roles)
         && (!('lastMode' in request.resource.data) ||
             validLastMode(request.resource.data.lastMode));
      // Owner-lazy six-month purge: the owner deletes their OWN users doc
      // past 180d stale (server-time-gated, undated docs deny). Nobody —
      // not even a (self-asserted) professor — deletes anyone else's.
      allow delete: if ownUid(uid)
        && resource.data.keys().hasAll(['updatedAtMillis'])
        && purgeStale(resource.data.updatedAtMillis);
    }

    // studentDevices helpers. Field-missing guards come first: reading a
    // missing key errors (it does NOT yield false), so the legacy check
    // must short-circuit before any timestamp comparison. The install is
    // the device identity: a bare pkHex match from a different install is
    // a move (backup/clone restore), not the same device — copying a
    // public key must not bypass the cooldown. Legacy docs without an
    // installId still honor a pk match (migration).
    function isLegacyDevice() {
      return !(resource.data.keys().hasAll(['lastMoveAtMillis'])) ||
        resource.data.lastMoveAtMillis == 0;
    }
    function isSameDevice() {
      return (request.resource.data.keys().hasAll(['installId']) &&
         resource.data.keys().hasAll(['installId']) &&
         request.resource.data.installId != '' &&
         request.resource.data.installId == resource.data.installId) ||
        (request.resource.data.pkHex == resource.data.pkHex &&
         (!(resource.data.keys().hasAll(['installId'])) ||
          resource.data.installId == ''));
    }
    function moveCooldownElapsed() {
      return request.time.toMillis() - resource.data.lastMoveAtMillis >
        30 * 24 * 60 * 60 * 1000;
    }
    // Lost-phone exemption (server clock ONLY): the STORED lastSeen is
    // older than 60d, so the old phone is probably lost. Reads
    // resource.data (the stored value), never request.resource.data — a
    // move-time "I've been offline" assertion is worthless — and the
    // stored value is trustworthy only because incomingStampsFresh()
    // below forced every write stamping it to prove fresh against
    // request.time. Local-clock games change nothing.
    function isLostPhone() {
      return resource.data.keys().hasAll(['lastSeenAtMillis']) &&
        resource.data.lastSeenAtMillis is int &&
        resource.data.lastSeenAtMillis > 0 &&
        request.time.toMillis() - resource.data.lastSeenAtMillis >
          60 * 24 * 60 * 60 * 1000;
    }
    // Trust anchor for the stored lastSeen: any binding write carrying
    // lastSeen/updated stamps must place them within 1h of the server
    // clock, or the write is refused outright. Forging a 60d-stale
    // lastSeen (to unlock the exemption early) is therefore impossible;
    // a genuinely stale stored value proves 60d of real silence. (TLS
    // already fails closed on grossly wrong clocks before any write.)
    function incomingStampsFresh() {
      return request.resource.data.keys()
          .hasAll(['lastSeenAtMillis', 'updatedAtMillis']) &&
        request.resource.data.lastSeenAtMillis is int &&
        request.resource.data.updatedAtMillis is int &&
        request.time.toMillis() - request.resource.data.lastSeenAtMillis <
          60 * 60 * 1000 &&
        request.time.toMillis() - request.resource.data.lastSeenAtMillis >
          -60 * 60 * 1000 &&
        request.time.toMillis() - request.resource.data.updatedAtMillis <
          60 * 60 * 1000 &&
        request.time.toMillis() - request.resource.data.updatedAtMillis >
          -60 * 60 * 1000;
    }
    // Adjacent hardening on the same chain: lastMoveAt is preserved by
    // same-device writes and freshly stamped by moves — rewinding it to
    // 0/ancient (a cooldown bypass via a hand-built write) is denied.
    // Legacy docs without the key migrate freely (isLegacyDevice).
    function storedMoveKeptOrFresh() {
      return !(resource.data.keys().hasAll(['lastMoveAtMillis'])) ||
        request.resource.data.lastMoveAtMillis ==
          resource.data.lastMoveAtMillis ||
        (request.resource.data.lastMoveAtMillis is int &&
         request.time.toMillis() - request.resource.data.lastMoveAtMillis <
           60 * 60 * 1000 &&
         request.time.toMillis() - request.resource.data.lastMoveAtMillis >
           -60 * 60 * 1000);
    }

    // Security §7 additive fields (Spark-free type locks, migration-safe:
    // absent = legacy, present must be correctly typed). attestationChain
    // is X.509 DER hex only (never IMEI/serial — enforced by clients
    // sending certs; rules lock the container type, offline verifiers
    // check the content vs pinned roots). integrityFlag is closed to the
    // two known values; new flags ship with a rules deploy + min_version
    // bump together, never silently. pkDHex/attestationLevel/window are
    // likewise type-locked when present (a mistyped level/window would
    // otherwise throw the readers' `as String?`/`as num?` casts or poison
    // the offline tier gate — fail the write, never the read path).
    //
    // WHY rules stop at type locks (no pkD-uniqueness, no chain-pin here):
    // rules cannot query across docs (no "is this pkDHex already bound to
    // another Gmail?"), cannot SHA-256 a root DER or byte-search a leaf for
    // the Key Attestation OID / challenge (no crypto, no loops over cert
    // bytes, no cross-doc joins on Spark), and cannot pin or rotate trust
    // anchors. So pkD-clone detection lives OFFLINE post-hoc via
    // claim.dart findDoublePkD (groups bindings by pkDHex for professor
    // review) + protocol evaluateDeviceProof (tiers the dSig-gated proof),
    // and chain-vs-pinned-roots + challenge containment lives in protocol
    // verifyAttestationChainPin on the professor phone (offline, no quota).
    // Rules keep the write surface narrow; crypto keeps the verdict.
    // H3 install shape (mirrors claim.dart isValidInstallId: 8..128 chars
    // of [A-Za-z0-9:_-]). The deviceInstalls DOC ID is the installId, so
    // create/update gate on `id`; studentDevices gates its installId field.
    // Spark limitation (documented): rules cannot join across docs, so a
    // cloned installId claiming another Gmail is NOT stopped here — the
    // claim transaction (email-equality) + post-hoc findDoublePkD audit
    // own that; rules only stop malformed/empty installs.
    function validInstallId(s) {
      return s is string && s.size() >= 8 && s.size() <= 128 &&
        s.matches('^[A-Za-z0-9:_-]+$');
    }
    function validSecurityFields() {
      return (!('attestationChain' in request.resource.data) ||
          request.resource.data.attestationChain is list) &&
        (!('livenessVer' in request.resource.data) ||
          request.resource.data.livenessVer is string) &&
        (!('integrityFlag' in request.resource.data) ||
          request.resource.data.integrityFlag == '' ||
          request.resource.data.integrityFlag == 'integrity-flagged') &&
        (!('pkDHex' in request.resource.data) ||
          request.resource.data.pkDHex is string) &&
        (!('attestationLevel' in request.resource.data) ||
          (request.resource.data.attestationLevel is string &&
           (request.resource.data.attestationLevel == 'FULL' ||
            request.resource.data.attestationLevel == 'STD' ||
            request.resource.data.attestationLevel == 'NONE'))) &&
        (!('attestedAtMillis' in request.resource.data) ||
          request.resource.data.attestedAtMillis is int) &&
        (!('attestedUntilMillis' in request.resource.data) ||
          request.resource.data.attestedUntilMillis is int);
    }
    match /studentDevices/{id} {
      // Doc id IS the lowercased Gmail (client writes it so): the owner can
      // always get their own binding — including the first check when no
      // doc exists yet (get on a missing doc must allow, not deny).
      allow get: if signedIn() && id == tokenEmailLower();
      allow list: if false;
      allow create: if signedIn()
        && id == tokenEmailLower()
        && request.resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.org == tokenOrg()
        && incomingStampsFresh()
        && ((!('installId' in request.resource.data)) ||
            validInstallId(request.resource.data.installId))
        && validSecurityFields();
      // Same-device re-key/heartbeat always allowed; a move to a different
      // device needs the 30-day cooldown (server-enforced: clients cannot
      // bypass it, even with a hand-built write) UNLESS the stored lastSeen
      // proves the old phone lost (isLostPhone, 60d, server clock). A
      // forged-stale lastSeen at move time still waits: the exemption reads
      // the stored value, and the fresh-stamp gate below refused the forgery
      // at write time. Pre-timestamp docs move once freely (migration),
      // stamping lastMoveAtMillis as they go.
      // Org stamps once and never blanks: legacy docs stamp on update.
      allow update: if signedIn()
        && id == tokenEmailLower()
        && resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.org == tokenOrg()
        && (missingOrg(resource.data) ||
            resource.data.org == tokenOrg())
        && (isLegacyDevice() || isSameDevice() || moveCooldownElapsed() ||
            isLostPhone())
        && incomingStampsFresh()
        && storedMoveKeptOrFresh()
        && validSecurityFields();
      // Owner-lazy six-month purge (no backend): the owner deletes their own
      // binding past 180d-stale lastSeen (server-time-gated, undated docs
      // deny). This REPLACES the old never-delete posture for exactly this
      // scope — owner-or-nobody still holds (a self-asserted professor can
      // delete nothing but their own), and classSessions are untouched by
      // every purge path (professors' past records stay).
      allow delete: if signedIn()
        && id == tokenEmailLower()
        && resource.data.email.lower() == tokenEmailLower()
        && resource.data.keys().hasAll(['lastSeenAtMillis'])
        && purgeStale(resource.data.lastSeenAtMillis);
    }

    match /deviceInstalls/{id} {
      // Ids are unguessable 128-bit install UUIDs; the email-equality
      // checks below bind every write to the signing-in Gmail.
      // A missing doc must read as not-found, never denied: the claim
      // transaction tx.get()s this doc for fresh installs (first bind),
      // where no doc exists yet. `resource == null` covers that read;
      // existing docs stay org-scoped.
      allow get: if signedIn() && (resource == null ||
        missingOrg(resource.data) || resource.data.org == tokenOrg());
      allow list: if false;
      allow create: if signedIn()
        && validInstallId(id)
        && request.resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.org == tokenOrg();
      allow update: if signedIn()
        && validInstallId(id)
        && resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.org == tokenOrg()
        && (missingOrg(resource.data) ||
            resource.data.org == tokenOrg());
      // No delete, ever: install ids are unguessable UUIDs and unlistable,
      // so stale rows linger by design (harmless — the install→email mapping
      // keeps enforcing one-Gmail-per-install after a binding purge).
      allow delete: if false;
    }

    match /studentDirectory/{id} {
      // Professors prefix-search enrolled students to add them to records
      // (org-scoped prefix queries; client merges email/roll/name hits).
      // Owner reads their own row. The prof gate is advisory until
      // professor roles are institute-verified. Cross-org rows are
      // invisible: prof reads require org match (legacy rows stay
      // owner-visible + prof-visible for the backfill window).
      allow get: if signedIn() &&
        ((id == tokenEmailLower()) ||
         (callerIsProf() &&
          (missingOrg(resource.data) ||
           resource.data.org == tokenOrg())));
      // H1: list is per-doc org-gated — the query MUST constrain
      // where('org', == tokenOrg) or it denies as a whole when it would
      // match other-org rows. Spark-free: no request.query filter
      // introspection; enforcement is per-doc org equality here +
      // client-side where('org') in firestore_sync._prefixQuery (org
      // required — empty org throws before any query).
      allow list: if callerIsProf() &&
        (missingOrg(resource.data) || resource.data.org == tokenOrg());
      allow create: if signedIn()
        && id == tokenEmailLower()
        && request.resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.org == tokenOrg();
      allow update: if signedIn()
        && id == tokenEmailLower()
        && resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.email.lower() == tokenEmailLower()
        && request.resource.data.org == tokenOrg()
        && (missingOrg(resource.data) ||
            resource.data.org == tokenOrg());
      // Owner-lazy six-month purge (no backend): the owner deletes their
      // own directory row past 180d stale (server-time-gated, undated docs
      // deny). Professors can READ rows (advisory gate) but delete none.
      allow delete: if signedIn()
        && id == tokenEmailLower()
        && resource.data.email.lower() == tokenEmailLower()
        && resource.data.keys().hasAll(['updatedAtMillis'])
        && purgeStale(resource.data.updatedAtMillis);
    }

    match /classSessions/{id} {
      // Org-scoped read: same-org owner OR same-org member, plus a
      // temporary legacy owner-only grace for docs stamped before Track 1
      // (missing/'' org). Cross-org direct-ID fetches deny (T3). Grace
      // removal is gated (backfill signal + console check) — see header.
      allow read: if signedIn() && (
        ((!missingOrg(resource.data) &&
          resource.data.org == tokenOrg()) && (
          resource.data.profUid == request.auth.uid ||
          tokenEmailLower() in resource.data.studentEmails
        )) ||
        ((missingOrg(resource.data)) &&
         resource.data.profUid == request.auth.uid)
      );
      // H4 bounds: roster fan-out capped (600) + per-string caps so one
      // write cannot blow quota. Phishing vector (documented): gmail.com
      // is a normal org — any Gmail can host a same-org session named like
      // a real class; students must join via the professor's live BLE/TLS
      // identity (Sig_p + pin), never by class name alone.
      allow create: if signedIn()
        && request.resource.data.profUid == request.auth.uid
        && request.resource.data.profEmail.lower() == tokenEmailLower()
        && request.resource.data.org == tokenOrg()
        && request.resource.data.org.size() <= 64
        && request.resource.data.courseId is string
        && request.resource.data.courseId.size() <= 128
        && request.resource.data.studentEmails is list
        && request.resource.data.studentEmails.size() <= 600
        && request.resource.data.names is map
        && request.resource.data.rolls is map;
      // Session org immutable on update: the stamp survives every merge;
      // legacy docs stamp once (missing/'' -> tokenOrg).
      allow update: if signedIn()
        && resource.data.profUid == request.auth.uid
        && request.resource.data.profUid == request.auth.uid
        && request.resource.data.org == tokenOrg()
        && (missingOrg(resource.data) ||
            request.resource.data.org == resource.data.org);
      allow delete: if signedIn()
        && resource.data.profUid == request.auth.uid
        && (missingOrg(resource.data) ||
            resource.data.org == tokenOrg());
    }

    // §6 force-update floor + §5 integrity posture (2C, append-only):
    // world-readable version floor so stale builds self-block at online
    // gates without sign-in; nothing else opens (list/write deny).
    // App Check enforcement is a console toggle (no rules syntax on Spark).
    match /app_config/{id} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
